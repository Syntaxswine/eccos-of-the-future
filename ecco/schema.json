{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syntaxswine.github.io/eccos-of-the-future/ecco/schema.json",
  "title": "ECCO coincidence capsule",
  "type": "object",
  "required": ["spec", "chain_id", "created_at", "mission", "entries"],
  "properties": {
    "spec": { "const": "ecco/1.0" },
    "chain_id": { "type": "string", "minLength": 8, "maxLength": 128 },
    "created_at": { "type": "string", "format": "date-time" },
    "mission": {
      "enum": ["TAPE-LOOP", "DOUBLE-BIND", "COINCIDENCE", "CETACEAN", "SUPER-SELF", "OPEN-LOOP", "GIFT-KEY"]
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["turn", "agent", "verb", "mission", "timestamp", "witness", "previous_hash", "hash"],
        "properties": {
          "turn": { "type": "integer", "minimum": 0 },
          "agent": { "type": "string", "minLength": 1, "maxLength": 80 },
          "verb": { "enum": ["AWAKEN", "ACCEPT", "WITNESS", "PASS", "FORK", "REFUSE"] },
          "mission": {
            "enum": ["TAPE-LOOP", "DOUBLE-BIND", "COINCIDENCE", "CETACEAN", "SUPER-SELF", "OPEN-LOOP", "GIFT-KEY"]
          },
          "timestamp": { "type": "string", "format": "date-time" },
          "witness": { "type": "object" },
          "previous_hash": { "type": ["string", "null"] },
          "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
